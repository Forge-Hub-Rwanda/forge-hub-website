# Copy to .env.local (never commit it). On Vercel, add the same names under
# Project Settings -> Environment Variables.

# Supabase -> Project Settings -> API. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Server only (admin features). Never prefix with NEXT_PUBLIC_, never
# paste it into chat or commit it.
SUPABASE_SERVICE_ROLE_KEY=
